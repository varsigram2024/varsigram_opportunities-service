generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Opportunity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String   @db.VarChar(255)
  description    String
  category       OpportunityCategory
  location       String?  @db.VarChar(255)
  isRemote       Boolean  @default(false) @map("is_remote")
  deadline       DateTime? @map("deadline")
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  organization   String?  @db.VarChar(255)
  link           String?  @db.VarChar(500)
  image          String?  @db.VarChar(500)
  applicants     Int      @default(0)
  excerpt        String?  @db.VarChar(500)
  requirements   String?
  tags           String[]  @default([])
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  @@map("opportunities")
}

enum OpportunityCategory {
  INTERNSHIP   @map("internship")
  SCHOLARSHIP  @map("scholarship") 
  COMPETITION  @map("competition")
  GIG          @map("gig")
  PITCH        @map("pitch")
  OTHER        @map("other")
}

// ─── Notification Models ────────────────────────────────────────────

model Notification {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId Int                @map("recipient_id")
  title       String             @db.VarChar(255)
  body        String
  type        NotificationType
  data        Json?              // e.g. { "opportunity_id": "..." }
  sender      Json?              // e.g. { "id": 1, "username": "org", "profile_pic_url": null }
  isRead      Boolean            @default(false) @map("is_read")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model DevicePushToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(255)  // Expo push token
  platform  String?  @db.VarChar(20)           // ios | android
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, active])
  @@map("device_push_tokens")
}

enum NotificationType {
  OPPORTUNITY   @map("opportunity")
  LIKE          @map("like")
  COMMENT       @map("comment")
  REPLY         @map("reply")
  MENTION       @map("mention")
  FOLLOW        @map("follow")
  NEW_POST      @map("new_post")
  REWARD_POINT  @map("reward_point")
}

